# Public URL of the deployed site (used for sitemap, canonical URL, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the contact form: submissions are posted to this Discord webhook.
# If empty, the form shows visitors an error asking them to email you instead.
DISCORD_WEBHOOK_URL=

# Profile links (public, shown on the site). Leave LinkedIn, Discord or booking empty to hide those buttons.
NEXT_PUBLIC_GITHUB_URL=https://github.com/mdevvx
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/mdevvx
NEXT_PUBLIC_LINKEDIN_URL=
# Discord server invite (https://discord.gg/...) or profile (https://discord.com/users/<your-id>)
NEXT_PUBLIC_DISCORD_URL=
# Calendly or other booking page for the "Book a call" buttons
NEXT_PUBLIC_BOOKING_URL=
