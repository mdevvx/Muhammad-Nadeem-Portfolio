# Public URL of the deployed site (used for sitemap, canonical URL, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the contact form: submissions are posted to this Discord webhook.
# If empty, the form shows visitors an error asking them to email you instead.
DISCORD_WEBHOOK_URL=

# Profile links (public, shown on the site). Leave LinkedIn, Discord or booking empty to hide those buttons.
NEXT_PUBLIC_GITHUB_URL=https://github.com/mdevvx
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/mdevvx
NEXT_PUBLIC_LINKEDIN_URL=
# Discord server invite (https://discord.gg/...) or profile (https://discord.com/users/<your-id>)
NEXT_PUBLIC_DISCORD_URL=
# Calendly or other booking page for the "Book a call" buttons
NEXT_PUBLIC_BOOKING_URL=

# Numbers shown on the site. Plain numbers only, formatting is automatic (30000 shows as $30K+).
# Leave a variable out to use the default. Changes need a rebuild/redeploy.
NEXT_PUBLIC_STAT_BOTS_BUILT=30
NEXT_PUBLIC_STAT_YEARS_EXPERIENCE=5
NEXT_PUBLIC_STAT_JOBS_COMPLETED=65
NEXT_PUBLIC_STAT_HOURS_DELIVERED=2669
NEXT_PUBLIC_STAT_TOTAL_EARNINGS=30000
NEXT_PUBLIC_STAT_TOTAL_REVIEWS=40
NEXT_PUBLIC_STAT_AVG_RATING=4.9

# Service prices in USD. Set one to empty (e.g. NEXT_PUBLIC_PRICE_SERVER_BUILDOUT=) to show "Custom pricing".
NEXT_PUBLIC_PRICE_COMMUNITY_MANAGEMENT=1500
NEXT_PUBLIC_PRICE_SERVER_BUILDOUT=350
NEXT_PUBLIC_PRICE_MODERATION_SECURITY=750
NEXT_PUBLIC_PRICE_STRATEGY_CONSULTING=

# Color palette: crimson (default, black + wine red), forest (green), rose (light, crimson), ink (black + gold), ember (orange), gold (bright gold), teal or lime. Needs a rebuild.
NEXT_PUBLIC_PALETTE=ink
# Theme first-time visitors see: dark or light. Leave out to use the palette's own default.
# NEXT_PUBLIC_DEFAULT_THEME=dark

# Optional Google Analytics measurement ID (G-XXXXXXXXXX). It only loads after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# Search engine verification tokens (optional). Google Search Console: HTML tag method, copy only the content value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
